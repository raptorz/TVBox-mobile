<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
    <ImageView android:id="@+id/cover" android:layout_width="72dp" android:layout_height="100dp" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="16sp" android:maxLines="2" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="12sp" android:paddingTop="4dp" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:max="1000" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.textview.MaterialTextView android:id="@+id/play" style="@style/Control" android:text="播放" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/toggle" style="@style/Control" android:text="继续缓存" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/delete" style="@style/Control" android:text="删除" />
        </LinearLayout>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/source" style="@style/Control" android:text="打开原视频" />
    </LinearLayout>
</LinearLayout>
